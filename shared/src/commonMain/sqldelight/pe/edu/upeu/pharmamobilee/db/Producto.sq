CREATE TABLE producto (
    propietario TEXT NOT NULL,
    id INTEGER NOT NULL,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    activo INTEGER NOT NULL DEFAULT 1,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT,
    requiereRevision INTEGER NOT NULL DEFAULT 0,
    proximoIntento INTEGER NOT NULL DEFAULT 0,
    categoriaId INTEGER,
    categoria TEXT NOT NULL DEFAULT 'Sin categoría',
    PRIMARY KEY (propietario, id)
);

CREATE TABLE sincronizacion_metadata (
    propietario TEXT NOT NULL PRIMARY KEY,
    ultima_correcta INTEGER
);

listarTodos:
SELECT * FROM producto WHERE propietario = ? ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE propietario = ? AND pendiente = 1 ORDER BY id DESC;

insertar:
INSERT OR REPLACE INTO producto(propietario, id, nombre, precio, stock, activo, pendiente, categoriaId, categoria)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto WHERE propietario = ? AND pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto WHERE propietario = ?;

borrarPorId:
DELETE FROM producto WHERE propietario = ? AND id = ?;

guardarUltimaSincronizacion:
INSERT OR REPLACE INTO sincronizacion_metadata(propietario, ultima_correcta)
VALUES (?, ?);

obtenerUltimaSincronizacion:
SELECT ultima_correcta FROM sincronizacion_metadata WHERE propietario = ?;

registrarFallo:
UPDATE producto SET intentos = intentos + 1, ultimoError = :mensaje,
requiereRevision = :revision, proximoIntento = :proximo WHERE propietario = :propietario AND id = :id;

prepararEnvio:
UPDATE producto SET requiereRevision = 1, ultimoError = 'Envío interrumpido: verifica el servidor antes de reenviar.' WHERE propietario = :propietario AND id = :id;

reintentar:
UPDATE producto SET requiereRevision = 0, intentos = CASE WHEN intentos >= 5 THEN 0 ELSE intentos END, ultimoError = NULL, proximoIntento = 0 WHERE propietario = :propietario AND id = :id AND pendiente = 1;

actualizarDatosPendientes:
UPDATE producto SET nombre = :nombre, precio = :precio, stock = :stock, activo = :activo, categoriaId = :categoriaId, categoria = :categoria WHERE propietario = :propietario AND id = :id AND pendiente = 1;

confirmarEnvio:
DELETE FROM producto WHERE propietario = :propietario AND id = :id AND pendiente = 1;

CREATE TABLE categoria_local (
    propietario TEXT NOT NULL,
    id INTEGER NOT NULL,
    nombre TEXT NOT NULL,
    PRIMARY KEY (propietario, id)
);

listarCategorias:
SELECT * FROM categoria_local WHERE propietario = ? ORDER BY nombre;

borrarCategorias:
DELETE FROM categoria_local WHERE propietario = ?;

insertarCategoria:
INSERT OR REPLACE INTO categoria_local(propietario, id, nombre) VALUES (?, ?, ?);

contarLegado:
SELECT COUNT(*) FROM producto WHERE propietario = '__legado_sin_asignar__' AND pendiente = 1;

listarLegado:
SELECT * FROM producto WHERE propietario = '__legado_sin_asignar__' AND pendiente = 1 ORDER BY id DESC;

asignarLegado:
UPDATE producto SET propietario = :propietario, id = :nuevoId, requiereRevision = 1,
ultimoError = COALESCE(ultimoError, 'Revisa categoría y servidor antes de reenviar.')
WHERE propietario = '__legado_sin_asignar__' AND id = :id AND pendiente = 1;
