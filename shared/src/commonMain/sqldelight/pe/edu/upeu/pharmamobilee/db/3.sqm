-- Conservar filas anteriores sin atribuirlas a una cuenta no acreditada.
ALTER TABLE producto RENAME TO producto_v3;
ALTER TABLE sincronizacion_metadata RENAME TO sincronizacion_metadata_v3;
CREATE TABLE producto (
    propietario TEXT NOT NULL,
    id INTEGER NOT NULL,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    activo INTEGER NOT NULL DEFAULT 1,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT,
    requiereRevision INTEGER NOT NULL DEFAULT 0,
    proximoIntento INTEGER NOT NULL DEFAULT 0,
    categoriaId INTEGER,
    categoria TEXT NOT NULL DEFAULT 'Sin categoría',
    PRIMARY KEY (propietario, id)
);

CREATE TABLE sincronizacion_metadata (
    propietario TEXT NOT NULL PRIMARY KEY,
    ultima_correcta INTEGER
);
INSERT INTO producto(propietario,id,nombre,precio,stock,activo,pendiente,intentos,ultimoError,requiereRevision,proximoIntento)
SELECT '__legado_sin_asignar__',id,nombre,precio,stock,activo,pendiente,intentos,ultimoError,requiereRevision,proximoIntento FROM producto_v3;
INSERT INTO sincronizacion_metadata SELECT '__legado_sin_asignar__',ultima_correcta FROM sincronizacion_metadata_v3;
DROP TABLE producto_v3;
DROP TABLE sincronizacion_metadata_v3;
CREATE TABLE categoria_local (
    propietario TEXT NOT NULL,
    id INTEGER NOT NULL,
    nombre TEXT NOT NULL,
    PRIMARY KEY (propietario, id)
);
